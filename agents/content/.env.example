# Copy to .env (gitignored) and fill in. Never commit real values.

# Z.ai GLM Coding Plan (https://api.z.ai/api/coding/paas/v4). Two keys = failover pool.
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_API_KEY=
GLM_API_KEY_2=

# Telegram bot from @BotFather; allowlist = numeric Telegram user IDs (chị Tâm, Viet), comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Where cron results (weekly topics, reminders) are delivered: a group chat ID
# (negative) or a user ID for a DM.
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=
# Group chats the bot may talk in (everyone in them is trusted).
TELEGRAM_GROUP_ALLOWED_CHATS=

# tbrain.ai agent API. Must equal CONTENT_AGENT_TOKEN in the Vercel project env (>=32 chars).
TBRAIN_API_BASE=https://www.tbrain.ai
CONTENT_AGENT_TOKEN=
