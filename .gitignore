# dependencies
/node_modules
/.pnp
/.env
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# raw video assets (only compressed copies in public/videos/ ship)
incoming-videos/

# local image backups (pre-blur originals, screenshot archives)
backup-images/

# misc local docs (client feedback, internal notes)
docs/website_revisions.docx

# typescript
*.tsbuildinfo
next-env.d.ts

# Vercel token (local only)
.env.vercel
scripts/.cs-backup-*.json
scripts/.cs-prod-backup-*.json
