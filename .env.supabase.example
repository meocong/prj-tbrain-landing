# ─── Supabase Official Cloud Test Environment ───
# Copy this file to `.env.supabase.local`, fill values from your Supabase project,
# then either copy those values into `.env.local` for local app testing or run
# commands with dotenvx/dotenv support.

# Project API settings: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for migrations:
# Supabase Dashboard → Project Settings → Database → Connection string
# Prefer the direct/session connection string for schema migrations.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Supabase CLI link:
# npm run supabase:login
# npm run supabase:link -- --project-ref <project-ref>
# npm run supabase:db:push
