# Copy to .env.local and fill in values.
# See .env.local.example for the full list with descriptions.

# --- Supabase (supabase.tbrain.ai) ---
NEXT_PUBLIC_SUPABASE_URL=https://supabase.tbrain.ai
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://supabase.tbrain.ai
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth secret for JWT session + approve tokens ---
# Generate with: openssl rand -base64 48
TB_AUTH_SECRET=

# --- Admin bootstrap (server-only) ---
ADMIN_BOOTSTRAP_EMAILS=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM="Tbrain <hello@noreply.tbrain.ai>"
ADMIN_EMAIL=drake@tbrain.ai

# --- Public base URL for email links ---
PUBLIC_BASE_URL=https://tbrain.ai

# --- Google Cloud Storage ---
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GCS_BUCKET_NAME=tbrain-landing

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
