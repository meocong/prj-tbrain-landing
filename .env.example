# Copy to .env.local and fill in values.
# See .env.local.example for the full list with descriptions.

# ─── Supabase (shared self-hosted instance at supabase.tbrain.ai) ───
# Same Supabase as prj-management — landing reads/writes on its own schema.
# This is NOT Supabase Cloud (.supabase.co) and NOT a localhost instance —
# it's the self-hosted PostgREST + GoTrue stack on the GCP VM.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.tbrain.ai
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://supabase.tbrain.ai
SUPABASE_SERVICE_ROLE_KEY=

# ─── Terminal Bench JWT signing key ───
# Used ONLY by the Terminal Bench passcode flow:
#   - signs the session cookie when a visitor enters a valid passcode
#   - signs the one-time approve link in the email an admin sends to a requester
# Verified in src/middleware.ts and src/lib/terminal-bench/auth.ts.
# NOT used by Supabase auth, NOT used by the rest of the site.
# Generate with: openssl rand -base64 48
TB_AUTH_SECRET=

# ─── Admin bootstrap (server-only) ───
# Comma-separated emails auto-promoted to super_admin on first Google sign-in
# at /admin/login. Leave blank to disable first-user bootstrap.
ADMIN_BOOTSTRAP_EMAILS=

# ─── Resend (transactional email) ───
# Domain noreply.tbrain.ai is verified in Resend; sender is hello@noreply.tbrain.ai
RESEND_API_KEY=
EMAIL_FROM="Tbrain <hello@noreply.tbrain.ai>"
ADMIN_EMAIL=drake@tbrain.ai

# ─── Public base URL for email links ───
PUBLIC_BASE_URL=https://tbrain.ai

# ─── Google Cloud Storage (shared bucket with prj-management) ───
# Service account key — paste private key inline (note the \n in the literal).
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GCS_BUCKET_NAME=tbrain-landing

# ─── Cloudflare Turnstile (CAPTCHA on contact + passcode forms) ───
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Cron secret (server-only, for /api/cron/* endpoints) ───
CRON_SECRET=
