# Copy to .env.local and fill in.

# --- Supabase (supabase.tbrain.ai) ---
# Either pair works; NEXT_PUBLIC_SUPABASE_URL is accepted for symmetry with
# other tbrain projects that share the same Supabase instance.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth secret for JWT session + approve tokens ---
# Generate with: openssl rand -base64 48
TB_AUTH_SECRET=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM="Tbrain <no-reply@tbrain.ai>"
ADMIN_EMAIL=drake@tbrain.ai

# --- Public base URL for email links ---
PUBLIC_BASE_URL=https://tbrain.ai

# --- Google Cloud Storage ---
# Preferred split form (matches other tbrain services):
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GCS_BUCKET_NAME=tbrain-landing
# Or (legacy) paste the full service-account JSON key inline:
GCS_SERVICE_ACCOUNT_JSON=

# --- Cloudflare Turnstile (optional in dev — leave blank to skip the widget) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
