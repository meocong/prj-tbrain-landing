# Copy to .env.local and fill in.

# --- Supabase (supabase.tbrain.ai) ---
NEXT_PUBLIC_SUPABASE_URL=https://supabase.tbrain.ai
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://supabase.tbrain.ai
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth secret for JWT session + approve tokens ---
# Generate with: openssl rand -base64 48
TB_AUTH_SECRET=

# --- Admin bootstrap (server-only, do NOT prefix with NEXT_PUBLIC_) ---
# Comma-separated emails that are auto-promoted to super_admin on first
# Google sign-in at /admin. Leave blank to disable first-user bootstrap.
ADMIN_BOOTSTRAP_EMAILS=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM="Tbrain <hello@noreply.tbrain.ai>"
ADMIN_EMAIL=drake@tbrain.ai

# --- Public base URL for email links ---
PUBLIC_BASE_URL=https://tbrain.ai

# --- Google Cloud Storage ---
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GCS_BUCKET_NAME=tbrain-landing
# Or (legacy) paste the full service-account JSON key inline:
GCS_SERVICE_ACCOUNT_JSON=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- WordPress GraphQL (existing CMS) ---
NEXT_PUBLIC_GRAPHQL_API=https://tbrain.ai/api/graphql

# --- Cron secret (for content-sync endpoint) ---
CRON_SECRET=
